if(APPLE)
if(NOT "$ENV{DEVELOPER_DIR}" STREQUAL "")
  set(SM64AR_DEVELOPER_DIR "$ENV{DEVELOPER_DIR}")
else()
  execute_process(COMMAND xcode-select -p OUTPUT_VARIABLE SM64AR_DEVELOPER_DIR OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
endif()
if(EXISTS "${SM64AR_DEVELOPER_DIR}/Contents/Developer")
  set(SM64AR_DEVELOPER_DIR "${SM64AR_DEVELOPER_DIR}/Contents/Developer")
endif()
set(SM64AR_XCODE_VERSION "")
if(EXISTS "${SM64AR_DEVELOPER_DIR}/../version.plist")
  file(READ "${SM64AR_DEVELOPER_DIR}/../version.plist" _sm64ar_plist)
  if(_sm64ar_plist MATCHES "<key>CFBundleShortVersionString</key>[ \t\r\n]*<string>([0-9][0-9.]*)</string>")
    set(SM64AR_XCODE_VERSION "${CMAKE_MATCH_1}")
  endif()
endif()
if(SM64AR_XCODE_VERSION STREQUAL "" OR SM64AR_XCODE_VERSION VERSION_LESS 26)
  message(FATAL_ERROR "Diorama64 needs Xcode 26 or newer (found '${SM64AR_XCODE_VERSION}' at '${SM64AR_DEVELOPER_DIR}'): "
                      "set DEVELOPER_DIR=/Applications/<Xcode 26 or newer>.app/Contents/Developer")
endif()
set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "")
if(CMAKE_SYSTEM_NAME STREQUAL "visionOS")
  if(NOT CMAKE_GENERATOR STREQUAL "Xcode")
    message(FATAL_ERROR "visionOS builds use the Xcode generator (Swift app): python3 scripts/visionos_build.py")
  endif()
  set(CMAKE_OSX_DEPLOYMENT_TARGET 26.0 CACHE STRING "")
  set(SM64AR_VISIONOS ON)
else()
  set(CMAKE_OSX_DEPLOYMENT_TARGET 14.0 CACHE STRING "")
  set(SM64AR_VISIONOS OFF)
endif()
else()
  set(SM64AR_VISIONOS OFF)
endif()
